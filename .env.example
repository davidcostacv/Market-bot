# Copy this file to .env and put your real token in it:
#     cp .env.example .env
#
# .env is gitignored and must STAY that way — this repository is PUBLIC, so a
# committed token is readable by anyone and must be revoked immediately.
#
# This file is only for running the bot on your own machine. GitHub Actions
# cannot read it (the runner only receives committed files); Actions reads the
# TELEGRAM_BOT_TOKEN repository secret instead.

TELEGRAM_BOT_TOKEN=paste-your-botfather-token-here
