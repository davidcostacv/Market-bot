# ---- WhatsApp Cloud API (Meta) ----
# Meta app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=EAAG...                 # permanent System User access token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_APP_SECRET=abcdef0123456789    # Meta app -> Settings -> Basic -> App Secret
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
GRAPH_API_VERSION=v21.0

# ---- Who is allowed to talk to the bot ----
# Comma separated, full international format, digits only. Anyone else is ignored.
ALLOWED_NUMBERS=34600111222

# ---- Claude ----
ANTHROPIC_API_KEY=sk-ant-...
# claude-opus-5 (best), claude-sonnet-5 (cheaper), claude-haiku-4-5 (cheapest)
ANTHROPIC_MODEL=claude-opus-5

# ---- Behaviour ----
PORT=3000
DB_PATH=./data/macros.db
DEFAULT_TIMEZONE=Europe/Madrid
DAILY_SUMMARY_HOUR=21              # local hour (0-23) for the automatic daily recap; blank disables
DEFAULT_KCAL_GOAL=2400
DEFAULT_PROTEIN_GOAL=180
DEFAULT_CARBS_GOAL=250
DEFAULT_FAT_GOAL=70
